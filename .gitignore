# Dataset PNGs stay local with the ignored data/ directory.
# PNGs in every other directory are tracked.

# accdesign: always track RTL golden-vector packages and export scripts
!/accdesign/
!/accdesign/**
!/accdesign/**/*
!/accdesign/**/*.bin
!/accdesign/**/*.pkl
!/accdesign/**/*.png
!/accdesign/**/*.pth
!/accdesign/data/
!/accdesign/data/**

# Bytecode stays local even inside the tracked accdesign tree.
accdesign/**/__pycache__/
accdesign/**/*.pyc

# DRAM comparison runs rewrite the same INT8 weight tables beside their outputs.
# Keep only the exports under the three scheme directories.
mycode/dram_footprint/*_hw_export/
mycode/dram_footprint/*/hw_export/
!mycode/dram_footprint/nonempty-block fixed allocation/hw_export/
!mycode/dram_footprint/nonempty-block fixed allocation/hw_export/**
!mycode/dram_footprint/page_with_fixed_block/hw_export/
!mycode/dram_footprint/page_with_fixed_block/hw_export/**
!mycode/dram_footprint/proposed page allocation/hw_export/
!mycode/dram_footprint/proposed page allocation/hw_export/**
